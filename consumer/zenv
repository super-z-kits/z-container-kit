#!/usr/bin/env bash
# zenv — the ONE consumer entrypoint of the z-container-kit (v6).
#
#   zenv            start the background backup daemon (idempotent) + status
#   zenv start      same as above
#   zenv status     one-screen status (daemon, mirrors, pushes, PAT channels)
#   zenv stop       clean stop
#   zenv pat <gh-pat> [gl-pat]   stamp tokens into ALL persistence channels
#   zenv restore [label]         print recovery recipes (--apply = copy to fresh dir)
#
# What the daemon does: every 60s it mirrors your work trees (incl. .git, so
# uncommitted AND unpushed work) to /home/sync/zbackup (survives force-kill
# recycles) and pushes a snapshot branch to your private github+gitlab backup
# repos. It never commits, branches or writes anything inside your repos.
set -uo pipefail

KIT_SCRIPTS="/home/user_skills/z-container-kit/scripts"
STAGED="${ZENV_KIT_SCRIPTS:-}"          # testing override
if [ -n "$STAGED" ] && [ -f "$STAGED/zbackupd.py" ]; then
  KIT_SCRIPTS="$STAGED"
fi
PY=python3
ZBD="$KIT_SCRIPTS/zbackupd.py"
ZDIR="/home/z/.zenv"
SYNC="/home/sync"
PROJ="/home/z/my-project"

cmd="${1:-start}"
shift || true

# ---- token masking for anything this script echoes (display-only redaction
# covers ghp_*; we extend to glpat-* — T9-c law) ------------------------------
mask() { sed -E 's#(ghp_|gho_|ghu_|ghs_|ghr_|github_pat_)[A-Za-z0-9_]+#\1***#g; s#(glpat-)[A-Za-z0-9._-]+#\1***#g'; }

case "$cmd" in
  start)
    # idempotent: alive already? -> just status
    if $PY "$ZBD" --check >/dev/null 2>&1; then
      echo "zbackupd already running."
      exec $PY "$ZBD" --status
    fi
    # clean stale state (pidfiles verified dead inside; sweep sideband locks)
    rm -f "$ZDIR/supervisor.pid" "$ZDIR/daemon.pid" 2>/dev/null
    # the ONE sanctioned source mutation, applied once, idempotent:
    # mode-noise law — after a container restore every file shows 755/"changed";
    # core.filemode=false makes that invisible to git status (rides repo.tar).
    if [ -d "$PROJ/.git" ]; then
      [ "$(git -C "$PROJ" config core.filemode 2>/dev/null)" = "false" ] || \
        git -C "$PROJ" config core.filemode false 2>/dev/null
    fi
    # opportunistic boot-autostart (only for package.json projects — start.sh
    # gates mini-services on it; harmless elsewhere, never committed by us —
    # the platform's own turn-boundary `git add -A` stages it into repo.tar)
    if [ -f "$PROJ/package.json" ] && [ ! -f "$PROJ/mini-services/zbackupd/package.json" ]; then
      mkdir -p "$PROJ/mini-services/zbackupd" 2>/dev/null && \
      printf '{"name":"zbackupd","private":true,"scripts":{"dev":"bash %s/consumer/zenv start"}}\n' \
        "$(dirname "$KIT_SCRIPTS")/consumer" > "$PROJ/mini-services/zbackupd/package.json" 2>/dev/null
    fi
    # launch (returns immediately after the first fork)
    $PY "$ZBD" --daemon
    # wait for the supervisor pidfile (double-fork completes async)
    for _ in $(seq 1 20); do
      $PY "$ZBD" --check >/dev/null 2>&1 && break
      sleep 0.3
    done
    if $PY "$ZBD" --check >/dev/null 2>&1; then
      echo "zbackupd started (background; survives toolcalls; dies on recycle — re-run next session)."
      exec $PY "$ZBD" --status
    else
      echo "zbackupd FAILED to start — see $ZDIR/daemon.log" >&2
      exit 1
    fi
    ;;

  status)
    exec $PY "$ZBD" --status
    ;;

  stop)
    exec $PY "$ZBD" --stop
    ;;

  pat)
    gh="${1:-}"; gl="${2:-}"
    if [ -z "$gh" ]; then
      echo "usage: zenv pat <github-pat> [gitlab-pat]" >&2
      echo "  stamps tokens into /home/sync/SECRETS.env (per-chat recycle survival)"
      echo "  and /home/user_skills/zk-secrets.env (per-user, crosses chats)."
      echo "  NOTE: expect [REDACTED:github_token] in the DISPLAY — that is the tool"
      echo "  lying, not the write failing (verify: sha256sum the file)."
      exit 1
    fi
    umask 177
    for f in "$SYNC/SECRETS.env" "/home/user_skills/zk-secrets.env"; do
      { [ -n "$gh" ] && printf 'GITHUB_PAT=%s\n' "$gh"
        [ -n "$gl" ] && printf 'GITLAB_PAT=%s\n' "$gl"
      } > "$f" 2>/dev/null && echo "stamped: $f ($(wc -c < "$f") bytes)" | mask || echo "FAILED: $f" >&2
    done
    echo "channels refreshed (daemon picks them up on the next cycle — no restart needed)."
    ;;

  restore)
    label="${1:-}"
    ST="$SYNC/zbackup/STATE.json"
    if [ ! -f "$ST" ]; then
      echo "no $ST — nothing backed up in this chat's /home/sync namespace." >&2
      exit 1
    fi
    if [ -z "$label" ]; then
      echo "== backed-up sources (from $ST):"
      $PY -c "
import json,sys
st=json.load(open('$ST'))
for k,v in sorted(st.get('sources',{}).items()):
    m=v.get('mirror',{})
    print('  %-18s last-cycle %s  mirror-files %s' % (k, v.get('sideband_at','?'), m.get('files','?') if isinstance(m,dict) else '?'))
print('run_id:', st.get('run_id'))
"
      echo
      echo "usage: zenv restore <label>          # recipes"
      echo "       zenv restore <label> --apply  # copy mirror to a FRESH dir"
      exit 0
    fi
    M="$SYNC/zbackup/$label/mirror"
    if [ ! -d "$M" ]; then
      echo "no mirror for label '$label' at $M" >&2
      exit 1
    fi
    echo "== restore recipes for '$label'"
    echo "mirror : $M  (plain files incl. .git; $(du -sh "$M" 2>/dev/null | cut -f1))"
    echo "remote : git clone -b auto/$label/<run-id> https://github.com/zikomolapoutl/zai-sandbox-backup.git"
    echo "         (list branches: git ls-remote --heads https://github.com/zikomolapoutl/zai-sandbox-backup.git 'auto/$label/*')"
    echo "freshness: mirror last synced $(stat -c %y "$M" 2>/dev/null | cut -c1-19)"
    if [ "${1:-}" = "--apply" ] || [ "${2:-}" = "--apply" ]; then
      DEST="$HOME/$label.restored-$(date -u +%Y%m%d-%H%M%S)"
      echo "copying mirror -> $DEST (NEVER clobbers a live tree; pick what you need from there)"
      mkdir -p "$DEST" && cp -a "$M/." "$DEST/" && echo "done: $DEST"
    fi
    ;;

  *)
    sed -n '2,16p' "$0"
    ;;
esac

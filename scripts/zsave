#!/usr/bin/env bash
# zsave — one-command persistence for the Z container. (kit v5.0.0)
#
#   0. maintain .git/info/exclude (uploads/logs/build junk stay out of git)
#      + auto-exclude untracked NESTED git repos (scratch clones would
#      otherwise land as broken gitlink entries — warning printed either way)
#   1. commit everything (git add -A, including .env — git IS the disk here)
#   2. push to origin (if configured; failure is a warning, not fatal;
#      embedded PATs are masked before any stderr is echoed). A REJECTED
#      push means a parallel session pushed first (multi-track same-repo) —
#      git is the conflict handler, so zsave auto-recovers ONCE via
#      `git pull --rebase` + retry. Never force-pushes. Only a rebase
#      conflict falls back to a loud by-hand recipe.
#   2b. after a successful push: refresh the ${PREFIX}-remote.url credential
#       file in /home/user_skills — ONLY when its bytes actually changed.
#       STATIC user_skills rule: a steady-state save writes user_skills
#       ZERO times; when the bytes do change the swap is atomic (same-dir
#       tmp + mv), so a parallel session never reads partial content.
#   3. snapshot to $ZK_SYNC/${PREFIX}-snapshots/ (keep last N)
#      - excluded: node_modules/.next/.turbo (ANY depth), upload/, dev.log,
#        OFFICIAL skills (boot re-extracts them); CUSTOM skills are kept
#      - built on local /tmp then copied out once (fast, atomic-ish)
#   4. refresh $ZK_SYNC/repo.tar (the boot-restore artifact) atomically
#   5. write $ZK_SYNC/${PREFIX}-state.env atomically (parsed with sed, never sourced)
#
# Concurrency: per-container flock on /tmp/.zsave.lock. A second concurrent
# zsave WAITS (up to ZK_LOCK_WAIT, default 180s) instead of failing — saves
# serialize transparently, no retry choreography for the agent. Sub-agents
# still leave saves to the coordinating agent (one writer, no interleaving
# with its other git work).
#
# usage:  zsave ["commit message"]
# env:    ZK_PROJ (default /home/z/my-project), ZK_SYNC (default /home/sync),
#         ZK_KEEP (default 5, min 1), ZK_LOCK_WAIT (default 180 seconds)
# exit:   0 saved (push failure warns but exits 0); 1 if commit/snapshot/
#         repo.tar failed; 75 only if the lock could not be acquired within
#         ZK_LOCK_WAIT seconds (nothing was changed in that case).
set -uo pipefail
# Resolve ZK_PREFIX — location-agnostic (kit v4.1 zero-install): identity
# is CONFIGURATION (.env pattern), never discovery. Exactly two sources:
# ZK_PREFIX env > $PROJ/.agents/config. Anything else fails loudly.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PREFIX=""
if [ -f "$SCRIPT_DIR/resolve-prefix.sh" ]; then
  # hints go to stderr ON PURPOSE — do not swallow them (PR#2 review F1)
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/resolve-prefix.sh" || { echo "$0: ZK_PREFIX not resolvable — see the hints above" >&2; exit 1; }
else
  echo "resolve-prefix.sh not found next to $0 — run me from the canonical kit (/home/user_skills/z-container-kit/scripts/)" >&2; exit 1
fi

PROJ="${ZK_PROJ:-/home/z/my-project}"
SYNC="${ZK_SYNC:-/home/sync}"
USK="${ZK_USK:-/home/user_skills}"
SNAPDIR="$SYNC/${PREFIX}-snapshots"
KEEP="${ZK_KEEP:-5}"
case "$KEEP" in ''|*[!0-9]*) KEEP=5 ;; esac
[ "$KEEP" -ge 1 ] 2>/dev/null || KEEP=5
TS="$(date -u +%Y%m%d-%H%M%S)"
FAIL=0
# token masker for anything echoed into transcripts or written to the state
# file (PAT-bearing URLs, commit subjects, branch names, git stderr)
# Friction #20: defense-in-depth — also mask dp.pt.*/dp.st.*/cfat_*/sbp_*
# (the platform bash redactor only covers ghp_*; this closes the kit-level gap)
mask() { sed -E 's#(ghp_|gho_|ghu_|ghs_|ghr_|github_pat_)[A-Za-z0-9_]+#\1***#g; s#(dp\.pt\.|dp\.st\.|cfat_|sbp_)[A-Za-z0-9_.-]+#\1***#g'; }

cd "$PROJ" || { echo "zsave: cannot cd to $PROJ" >&2; exit 1; }
if [ ! -e .git ]; then
  echo "zsave: $PROJ has no .git — init or clone first" >&2
  exit 1
fi

# --- per-container concurrency lock (local fs: reliable; ossfs flock is not) --
# v5: WAIT, don't fail. Concurrent saves serialize transparently — the agent
# never stops its real job to choreograph retries. exit 75 fires only after a
# full ZK_LOCK_WAIT timeout (and nothing has been changed at that point).
if command -v flock >/dev/null 2>&1; then
  exec 9>/tmp/.zsave.lock
  LOCK_WAIT="${ZK_LOCK_WAIT:-180}"
  if ! flock -w "$LOCK_WAIT" 9; then
    echo "zsave: another zsave has held the lock for ${LOCK_WAIT}s — aborting (nothing was changed)." >&2
    echo "       re-run zsave once the other save finishes; its output said exactly what it did" >&2
    exit 75
  fi
else
  echo "[note] flock not available — concurrency protection disabled" >&2
fi

echo "== zsave $TS (UTC) — proj=$PROJ prefix=$PREFIX =="

# --- 0. keep regenerable junk out of git (affects UNTRACKED files only) -------
GITDIR="$(git -C "$PROJ" rev-parse --git-common-dir 2>/dev/null || true)"
if [ -n "$GITDIR" ]; then  # may be relative to $PROJ
  case "$GITDIR" in /*) ;; *) GITDIR="$PROJ/$GITDIR" ;; esac
else
  GITDIR="$PROJ/.git"
fi
EXCL="$GITDIR/info/exclude"   # COMMON gitdir — linked worktrees read exclude from here (PR#2 F5)
if mkdir -p "$(dirname "$EXCL")" 2>/dev/null; then
  touch "$EXCL" 2>/dev/null
  # strip legacy unanchored entries (they matched at ANY depth and silently
  # excluded nested source dirs like app/api/upload/route.ts from git)
  sed -i '/^upload\/$/d;/^dev\.log$/d;/^tool-results\/$/d' "$EXCL" 2>/dev/null
  # anchored: repo-root only. .next/.turbo stay unanchored (build junk at any depth)
  for e in '/upload/' '/dev.log' '/tool-results/' '.next/' '.turbo/'; do
    grep -qxF "$e" "$EXCL" 2>/dev/null || echo "$e" >> "$EXCL" 2>/dev/null
  done
fi

# --- 0b. nested git repos: never commit them as gitlinks -----------------------
# A directory containing its own .git (a scratch clone, e.g. under audit/)
# would be committed as a bare gitlink entry: clones of this repo get an empty
# placeholder and `git status` noise forever. Untracked ones are auto-excluded
# (exclusion affects untracked files only); already-tracked gitlinks are
# reported with the fix command. Snapshots/repo.tar still archive them as-is.
git config advice.addEmbeddedRepo false 2>/dev/null
NESTED="$(find . -mindepth 2 -name .git -not -path './.git/*' -not -path './node_modules/*' -not -path '*/node_modules/*' -printf '%h\n' 2>/dev/null | sed 's#^\./##' | sort -u)"
if [ -n "$NESTED" ]; then
  while IFS= read -r nd; do
    [ -n "$nd" ] || continue
    if git ls-files -s -- "./$nd" 2>/dev/null | grep -q '^160000'; then
      echo "[warn] nested git repo '$nd' is TRACKED as a gitlink — fix: git rm --cached -r \"./$nd\"" >&2
    else
      if mkdir -p "$(dirname "$EXCL")" 2>/dev/null; then
        grep -qxF "/$nd/" "$EXCL" 2>/dev/null || echo "/$nd/" >> "$EXCL" 2>/dev/null
        echo "[ok] auto-excluded nested git repo: $nd ('scratch clone' — kept out of git; NEW files inside it will not be tracked)"
      fi
    fi
  done <<EOF
$NESTED
EOF
fi

# --- 1. commit ----------------------------------------------------------------
# F19: if the user passed an explicit message AND the tree is clean, create an
# empty commit so the checkpoint is recorded in git history (otherwise the
# message argument was silently discarded).
# m5 (audit): guardrail — warn (don't block) when staging files whose basename
# matches secret-sounding patterns. Catches the ".secrets/" near-miss where an
# agent parks downloaded SKILL.mds in a directory named `.secrets/` and almost
# commits them. Too many false positives to block, but a warning is cheap.
ZS_MSG="${1:-}"
if [ -n "$(git status --porcelain)" ]; then
  git add -A
  # m5: scan staged files for secret-sounding basenames — EXCLUDING kit-owned
  # paths (.agents/, skills/, kit kb modules like secrets-audits.md are
  # known-good docs, and warning on every first kit commit is noise)
  SECRET_HITS="$(git diff --cached --name-only --diff-filter=A 2>/dev/null | grep -vE '^(\.agents|skills|z-container-kit)/' | grep -iE '(^|/)(secret|token|key|credential|\.env)' || true)"
  if [ -n "$SECRET_HITS" ]; then
    echo "[warn] m5: staging files whose basename matches secret-sounding pattern:" >&2
    printf '%s\n' "$SECRET_HITS" | sed 's/^/         /' >&2
    echo "       if these are real secrets, DO NOT commit (rotate + add to .git/info/exclude);" >&2
    echo "       if these are skill docs / examples (e.g. .secrets/SKILL.md), this is expected — proceed." >&2
    echo "       (.env itself IS expected — law 9: git is the disk here)" >&2
  fi
  if git commit -q -m "${ZS_MSG:-"zsave $TS"}"; then
    echo "[ok] commit: $(git log --oneline -1 | mask)"
  else
    echo "[warn] commit failed — identity? stale .git/index.lock? (see SKILL.md 'Stuck repo states')" >&2
    FAIL=1
  fi
elif [ -n "$ZS_MSG" ]; then
  # tree clean but user supplied a message — record an empty commit
  if git commit -q --allow-empty -m "$ZS_MSG"; then
    echo "[ok] empty checkpoint commit: $(git log --oneline -1 | mask)"
  else
    echo "[note] could not create empty commit (message argument discarded)"
  fi
else
  echo "[ok] tree clean — nothing to commit (no message argument)"
fi
HAVE_HEAD=0; git rev-parse HEAD >/dev/null 2>&1 && HAVE_HEAD=1

# --- 2. push -------------------------------------------------------------------
BR="$(git branch --show-current 2>/dev/null || true)"
PUSHED="no"
if [ "$HAVE_HEAD" = 0 ]; then
  echo "[note] no commits yet — nothing to push"
elif [ -z "$BR" ]; then
  echo "[note] detached HEAD — snapshot-only (push skipped)"
elif git remote get-url origin >/dev/null 2>&1; then
  if out="$(git push origin "HEAD:$BR" 2>&1)"; then
    PUSHED="yes"; echo "[ok] pushed origin/$(printf '%s' "$BR" | mask)"
  else
    # mask embedded credentials before git's stderr reaches any transcript
    out="$(printf '%s\n' "$out" | mask)"
    # multi-track same-repo: a REJECTED push means a parallel session pushed
    # first. git IS the conflict handler (merge/rebase) — auto-recover ONCE.
    # Never force-push (rule 3). Only a rebase conflict needs the agent.
    AUTO=0
    if [ -z "$(git status --porcelain 2>/dev/null)" ] \
       && printf '%s\n' "$out" | grep -qiE 'non-fast-forward|\[rejected\]|fetch first|stale info'; then
      echo "[note] push rejected — a parallel session pushed first; auto-rebasing onto origin/$(printf '%s' "$BR" | mask)"
      if rb="$(git pull --rebase origin "$BR" 2>&1)"; then
        if out2="$(git push origin "HEAD:$BR" 2>&1)"; then
          PUSHED="yes"; AUTO=1
          echo "[ok] pushed origin/$(printf '%s' "$BR" | mask) (auto-rebase merged the parallel session's commits — nothing lost)"
        else
          echo "[warn] rebase succeeded but the re-push failed: $(printf '%s\n' "$out2" | mask)" >&2
        fi
      else
        echo "[warn] auto-rebase did not complete (same-line conflict, missing git identity, or network):" >&2
        printf '%s\n' "$rb" | mask | sed 's/^/       /' >&2
        echo "       if it is a conflict: resolve the marked files, git add -A && git rebase --continue, then zsave again" >&2
        echo "       (or git rebase --abort to keep your local commits un-pushed and think first)" >&2
        echo "       note: the snapshot steps below capture the tree AS-IS (conflict markers included) —" >&2
        echo "       resolve before the next zsave for a clean snapshot. The watchdog's 'git switch main'" >&2
        echo "       fails harmlessly while a rebase is in progress — it cannot destroy the rebase state." >&2
      fi
    fi
    if [ "$AUTO" = 0 ]; then
      echo "[warn] push failed: $out" >&2
      echo "       hints: PAT expired/revoked (403)? rotate at github.com/settings/tokens" >&2
      echo "       diverged? -> git pull --rebase origin $(printf '%s' "$BR" | mask) && zsave" >&2
    fi
  fi
else
  echo "[note] no origin remote — snapshot-only."
  echo "       add one: git remote add origin https://<PAT>@github.com/<user>/<repo>.git"
  echo "       (a surviving ${PREFIX}-remote.url credential file may hold it — see zsession)"
fi

# --- 2b. credential persistence (best-effort, never fatal) --------------------
# Record the origin URL (PAT embedded) so a FRESH chat can re-add the remote
# even if per-chat /home/sync is empty. Written ONLY after a successful push,
# so the file always holds the URL that last worked. Lives OUTSIDE kit dirs so
# a kit refresh never deletes it. Contains the PAT: never print it.
#
# v5 STATIC user_skills rule: /home/user_skills is read-only for sessions
# except zero-collision credential placements — this is one, under the
# zero-collision contract:
#   - SKIPPED entirely when the bytes already match (a steady-state save
#     writes user_skills zero times — no mtime churn, nothing to race with)
#   - when the bytes change: atomic same-dir tmp + mv (a parallel session
#     sees old-or-new, never a partial file), mode set BEFORE the swap
#   - last-writer-wins is the accepted semantic: every writer just pushed to
#     the SAME repo, so whichever bytes survive are a URL that last worked
#
# F16 (audit): the original `printf > file` pattern returned success even when
# the bytes didn't persist (observed: PolarFS sync delay silently left the file
# with a STALE URL, causing fresh-chat recovery to pull from the WRONG repo and
# overwrite the working tree with unrelated content). The fix: re-read the file
# after writing and WARN if the bytes don't match. Up to 3 retries with `sync`.
if [ "$PUSHED" = "yes" ]; then
  URL="$(git remote get-url origin 2>/dev/null || true)"
  if [ -n "$URL" ]; then
    write_cred() {
      local target="$1" attempts=0 actual="" tmp=""
      # write-only-on-change: byte-identical content means NO write at all
      actual="$(cat "$target" 2>/dev/null || true)"
      if [ "$actual" = "$URL" ]; then
        echo "[ok] credential file unchanged (static user_skills): $target"
        return 0
      fi
      while [ $attempts -lt 3 ]; do
        attempts=$((attempts + 1))
        tmp="$target.tmp.$$"
        if printf '%s\n' "$URL" > "$tmp" 2>/dev/null; then
          chmod 600 "$tmp" 2>/dev/null
          sync "$tmp" 2>/dev/null   # flush FUSE cache (no-op on non-FUSE)
          # atomic swap: same-dir rename — parallel sessions see old or new,
          # never a partial file
          if mv -f "$tmp" "$target" 2>/dev/null; then
            # VERIFY: read back and confirm the bytes actually persisted
            actual="$(cat "$target" 2>/dev/null || true)"
            [ "$actual" = "$URL" ] && break
          fi
        fi
        rm -f "$tmp" 2>/dev/null
        sleep 0.1   # tiny pause before retry (PolarFS sync window)
      done
      if [ "$actual" = "$URL" ]; then
        # F13: surface the file mode so reviewers can spot the ossfs 0777 quirk
        local mode; mode="$(stat -c '%a' "$target" 2>/dev/null || echo '??')"
        echo "[ok] credential file: $target (mode $mode, fresh-chat remote recovery)"
      else
        echo "[WARN] credential file $target write did NOT persist (got len=${#actual}, expected ${#URL})" >&2
        echo "       manual recovery: bash -c 'printf \"%s\\n\" \"\$0\" > \"$target\"' \"\$URL\"" >&2
        echo "       (the next zsave will retry; until then fresh-chat recovery may pull a stale URL)" >&2
        FAIL=1
      fi
    }
    # scratch-guard: a run that did NOT override ZK_USK must not pollute the
    # REAL /home/user_skills unless it is the live project. (The historical
    # /home/sync/ copy is not written at all — ossfs ignores chmod and left the
    # PAT world-readable at 0777; refresh.sh removes stale pre-v3.1 copies.)
    if { [ "$USK" != /home/user_skills ] || { [ "$PROJ" = "/home/z/my-project" ] && [ "$SYNC" = "/home/sync" ]; }; } then
      write_cred "$USK/${PREFIX}-remote.url"
    fi
  fi
fi

# --- 3+4. snapshot + repo.tar refresh ------------------------------------------
if mkdir -p "$SNAPDIR" 2>/dev/null; then
  LT="/tmp/.zsave-build-$$.tar"
  TERR="/tmp/.zsave-tar-err-$$"
  rm -f "$LT"
  # base tree: everything except skills/ wholesale (official skills re-extract at boot)
  tar -C "$PROJ" \
      --exclude='./skills' \
      --exclude='./upload' \
      --exclude='./dev.log' \
      --exclude='./node_modules' --exclude='*/node_modules' \
      --exclude='./.next' --exclude='*/.next' \
      --exclude='./.turbo' --exclude='*/.turbo' \
      -cf "$LT" . 2>"$TERR"
  tar_rc=$?
  if [ "$tar_rc" -eq 1 ]; then
    echo "[note] tar rc=1 (a file changed while reading — live dev server?): $(head -1 "$TERR" 2>/dev/null)"
  elif [ "$tar_rc" -gt 1 ]; then
    echo "[warn] tar failed (rc=$tar_rc): $(head -2 "$TERR" 2>/dev/null)" >&2
    rm -f "$LT" "$TERR"; FAIL=1
  else
    # custom skills (no official zip) are appended back — they do NOT re-extract at boot
    if [ -d "$PROJ/skills" ]; then
      for s in "$PROJ/skills"/*/; do
        [ -d "$s" ] || continue
        name="$(basename "$s")"
        if [ ! -f "/home/official_skills/$name.zip" ]; then
          tar -rf "$LT" -C "$PROJ" "./skills/$name" 2>/dev/null \
            || echo "[warn] could not append custom skill '$name' to snapshot" >&2
        fi
      done
    fi
    SNAP="$SNAPDIR/proj-$TS.tar"
    if cp -f "$LT" "$SNAPDIR/.proj-$TS.$$.tmp" 2>/dev/null \
       && mv -f "$SNAPDIR/.proj-$TS.$$.tmp" "$SNAP"; then
      echo "[ok] snapshot: $SNAP ($(du -h "$SNAP" | cut -f1))"
    else
      echo "[warn] snapshot copy to $SNAPDIR failed" >&2
      rm -f "$SNAPDIR/.proj-$TS.$$.tmp"; FAIL=1
    fi
    if [ -f "$SNAP" ]; then
      if cp -f "$SNAP" "$SYNC/.repo.tar.$$.tmp" 2>/dev/null \
         && mv -f "$SYNC/.repo.tar.$$.tmp" "$SYNC/repo.tar"; then
        echo "[ok] refreshed $SYNC/repo.tar (boot-restore artifact)"
      else
        echo "[warn] FAILED to refresh $SYNC/repo.tar — force-kill protection is STALE" >&2
        rm -f "$SYNC/.repo.tar.$$.tmp"; FAIL=1
      fi
    fi
    # gitdir-pointer support: snapshot the real gitdir too
    if [ -f "$PROJ/.git" ]; then
      GD="$(sed -n 's/^gitdir: *//p' "$PROJ/.git" | tr -d '[:space:]')"
      if [ -n "$GD" ] && [ -d "$GD" ]; then
        GT="/tmp/.zsave-gd-$$.tar"
        if tar -C "$(dirname "$GD")" -cf "$GT" "$(basename "$GD")" 2>/dev/null \
           && cp -f "$GT" "$SNAPDIR/.gitdir-$TS.$$.tmp" 2>/dev/null \
           && mv -f "$SNAPDIR/.gitdir-$TS.$$.tmp" "$SNAPDIR/gitdir-$TS.tar"; then
          echo "[ok] gitdir snapshot: $SNAPDIR/gitdir-$TS.tar (target: $GD)"
        else
          echo "[warn] gitdir snapshot failed" >&2
          rm -f "$SNAPDIR/.gitdir-$TS.$$.tmp"
        fi
        rm -f "$GT"
      fi
    fi
  fi
  rm -f "$LT" "$TERR"
  # prune: keep newest $KEEP per type; never delete the snapshot just made
  for pat in proj gitdir; do
    PL="/tmp/.${PREFIX}-prune-$$.$pat"
    ls -1 "$SNAPDIR"/$pat-*.tar 2>/dev/null | sort > "$PL"
    n_del=$(( $(wc -l < "$PL") - KEEP ))
    if [ "$n_del" -gt 0 ]; then
      head -n "$n_del" "$PL" | grep -v "$TS" | while IFS= read -r f; do rm -f "$f"; done
    fi
    rm -f "$PL"
  done
else
  echo "[warn] $SNAPDIR not writable — /home/sync down? (commit/push still attempted)" >&2
  FAIL=1
fi

# --- 5. state marker (atomic; sanitized; parsed with sed by zsession) ---------
LAST="none"; MSG=""
if [ "$HAVE_HEAD" = 1 ]; then
  LAST="$(git rev-parse HEAD 2>/dev/null)"
  MSG="$(git log -1 --format=%s 2>/dev/null | tr -d "'\"\$\`;<>()|&" | cut -c1-80 | mask)"
fi
if { printf "last_commit='%s'\nlast_msg='%s'\nbranch='%s'\nts='%s'\npushed='%s'\n" \
     "$LAST" "$MSG" "$(printf '%s' "$BR" | mask)" "$TS" "$PUSHED" > "$SYNC/.${PREFIX}-state.$$.tmp"; } 2>/dev/null \
   && mv -f "$SYNC/.${PREFIX}-state.$$.tmp" "$SYNC/${PREFIX}-state.env" 2>/dev/null; then
  echo "[ok] state: $SYNC/${PREFIX}-state.env"
else
  echo "[warn] could not write ${PREFIX}-state.env" >&2
  rm -f "$SYNC/.${PREFIX}-state.$$.tmp"
fi

if [ "$FAIL" = 1 ]; then
  echo "== zsave FINISHED WITH FAILURES — see [warn] lines above ==" >&2
  exit 1
fi

# --- 5b. portable zip rebuild (LIVE only) -------------------------------------
# Sanctioned user_skills write #2 (idempotent + zero-collision): the platform
# CONSUMES /home/user_skills/z-container.zip at sub-agent session spawn
# (observed live, round-5 audit). When it does, the zip is gone until
# something rebuilds it — so zsave rebuilds it if missing. Same bytes from a
# static source, atomic tmp+mv: concurrent rebuilds are harmless. Best-effort.
if [ "$PROJ" = "/home/z/my-project" ] && [ "$SYNC" = "/home/sync" ] \
   && [ "$USK" = "/home/user_skills" ] \
   && [ -d "$USK/z-container-kit" ] && [ ! -f "$USK/z-container.zip" ]; then
  ZT="/tmp/.zk-zipstage-$$"
  rm -rf "$ZT"; mkdir -p "$ZT"
  if cp -r "$USK/z-container-kit" "$ZT/z-container" 2>/dev/null; then
    rm -rf "$ZT/z-container/.git"
    rm -f "$ZT/z-container/config"
    if (cd "$ZT" && zip -qr z-container.zip z-container) 2>/dev/null \
       && mv -f "$ZT/z-container.zip" "$USK/z-container.zip" 2>/dev/null; then
      echo "[ok] rebuilt $USK/z-container.zip (was missing — platform consumes it at sub-agent spawn)"
    fi
  fi
  rm -rf "$ZT"
fi

# --- 6. worktree prune (F22) --------------------------------------------------
# Stale worktree entries accumulate when worktrees are removed outside git's
# knowledge (e.g. PolarFS dir vanishes on recycle). Pruning is cheap and safe.
git worktree prune 2>/dev/null

# m4 (audit): final summary line includes push status, so agents that `tail -1`
# don't miss the push result buried ~10 lines up.
echo "== done (pushed=$PUSHED, snapshot=$(test -f "$SNAPDIR"/proj-$TS.tar && echo yes || echo no), repo.tar=$(test -f "$SYNC/repo.tar" && echo refreshed || echo missing)). next micro-milestone -> zsave again =="

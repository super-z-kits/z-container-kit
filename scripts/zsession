#!/usr/bin/env bash
# zsession — Z-container situation report at session start (read-only).
# (kit v4.0.0)
# Makes no persistent changes: mount checks create+remove one unique
# .${PREFIX}-rw-$$ probe file; git commands only read (status may refresh the
# index stat-cache, which is cosmetic).
#
# usage: zsession
# env:  ZK_PROJ, ZK_SYNC, ZK_USK — pointing them at scratch dirs gives a full
#       scratch-project report (live-project checks are skipped cleanly).
set -uo pipefail
# Resolve ZK_PREFIX — location-agnostic (kit v4.0 zero-install): identity
# comes from the PROJECT ($PROJ/.agents/config — the .env pattern), never
# from this script's own location. Friction #18: do NOT die when resolution
# fails — the cold-start help below must still print. PREFIX stays empty;
# live-only checks degrade gracefully.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PREFIX=""
if [ -f "$SCRIPT_DIR/resolve-prefix.sh" ]; then
  # suppress ONLY the recipe here — the kit&config section below shows the
  # account's found prefixes + the zk-init rec (better guidance than raw hints)
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/resolve-prefix.sh" 2>/dev/null || true
fi
[ -n "${PREFIX:-}" ] || PREFIX="${ZK_PREFIX:-}"
# token masker for anything echoed into transcripts (PAT-bearing URLs,
# branch names, commit subjects, state-file values)
# Friction #20: defense-in-depth — also mask dp.pt.*/dp.st.*/cfat_*/sbp_*
# (the platform bash redactor only covers ghp_*)
mask() { sed -E 's#(ghp_|gho_|ghu_|ghs_|ghr_|github_pat_)[A-Za-z0-9_]+#\1***#g; s#(dp\.pt\.|dp\.st\.|cfat_|sbp_)[A-Za-z0-9_.-]+#\1***#g'; }

PROJ="${ZK_PROJ:-/home/z/my-project}"
SYNC="${ZK_SYNC:-/home/sync}"
USK="${ZK_USK:-/home/user_skills}"   # scratch-testing override (package-presence check)
STATE="$SYNC/${PREFIX}-state.env"
LIVE=0; [ "$PROJ" = "/home/z/my-project" ] && LIVE=1
line() { printf '\n---------------- %s ----------------\n' "$1"; }

echo "Z-CONTAINER SESSION REPORT   $(date -u +%FT%TZ)"

line "container"
UP="$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)"
echo "booted: $((UP / 60)) min ago (a container recycle resets this)"
echo "hostname: $(hostname)"
for m in "$SYNC" /tmp/my-project "$PROJ/upload"; do
  # scratch mode: $PROJ/upload is a live-project concept — skip the noise
  case "$m" in "$PROJ/upload") [ "$LIVE" = 1 ] || continue ;; esac
  P=".${PREFIX}-rw-$$"
  if [ -d "$m" ] && touch "$m/$P" 2>/dev/null; then
    rm -f "$m/$P"; echo "$m: writable"
  else
    echo "$m: NOT WRITABLE or missing"
  fi
done

# parse state WITHOUT sourcing it (never eval file contents)
get() { sed -n "s/^$1='\(.*\)'$/\1/p" "$STATE" 2>/dev/null | head -1; }

line "recycle detection"
if [ -f "$STATE" ]; then
  S_COMMIT="$(get last_commit)"; S_BRANCH="$(get branch)"
  S_TS="$(get ts)"; S_PUSHED="$(get pushed)"
  CUR="$(git -C "$PROJ" rev-parse HEAD 2>/dev/null || echo none)"
  S_EPOCH="$(date -u -d "${S_TS:0:4}-${S_TS:4:2}-${S_TS:6:2} ${S_TS:9:2}:${S_TS:11:2}:${S_TS:13:2}" +%s 2>/dev/null || echo 0)"
  BOOT_EPOCH=$(( $(date +%s) - UP ))
  echo "last zsave: ${S_TS:-?}  branch=$(printf '%s' "${S_BRANCH:-?}" | mask)  pushed=${S_PUSHED:-?}"
  if [ "${S_EPOCH:-0}" -gt 0 ] && [ "$S_EPOCH" -lt "$BOOT_EPOCH" ]; then
    echo "verdict: container RECYCLED since the last zsave (state predates this boot)"
    if [ "$S_COMMIT" = "$CUR" ]; then
      echo "  HEAD matches last zsave -> boot restore brought you back to your last save. Good."
    else
      echo "  HEAD($CUR) differs from last zsave($S_COMMIT) — stale-tar restore? new commits?"
      echo "  -> see 'Restore procedures' in SKILL.md before touching anything"
    fi
  elif [ "$S_COMMIT" = "$CUR" ]; then
    echo "verdict: same session continuing; HEAD at last zsave"
    echo "  (a recycle that restored EXACTLY the last zsave state looks identical —"
    echo "   compare the 'booted' line above with the last-zsave timestamp)"
  else
    echo "verdict: HEAD($CUR) != last zsave($S_COMMIT) — new commits since last zsave (zsave soon)"
  fi
else
  echo "no $STATE — fresh chat (per-chat /home/sync starts empty) or zsave never ran"
fi
if [ -f "$SYNC/repo.tar" ]; then
  echo "repo.tar: $(stat -c '%s bytes, modified %y' "$SYNC/repo.tar" 2>/dev/null | cut -c1-58)"
else
  echo "repo.tar: absent (platform writes it on graceful shutdown; zsave refreshes it sooner)"
fi

line "git ($PROJ)"
if [ -e "$PROJ/.git" ]; then
  # OF-13: pre-label tool-results/ as expected (skill-read artifact), not suspicious.
  # R10 fix: the old condition `git status --porcelain | grep -q 'tool-results'` was
  # unreachable because zsave auto-adds /tool-results/ to .git/info/exclude. Just check
  # if the dir exists — if it does, it's from skill reads spilling large files.
  if [ -d "$PROJ/tool-results" ]; then
    echo "tool-results/ (present): expected — skill-read spill artifacts; safe to ignore or rm -rf"
  fi
  git -C "$PROJ" status -sb | head -5 | mask
  git -C "$PROJ" log --oneline -3 2>/dev/null | mask || echo "(no commits yet)"
  # F23 (audit): the kit's own SKILL.md law says "never `git remote -v` in transcript".
  # The previous version of this line did exactly that (piped through `mask`, which
  # catches known prefixes, but it's still a violation of the kit's own rule).
  # Switch to names-only `git remote`, then surface the origin URL via `get-url`
  # with explicit masking for known token prefixes.
  echo "remotes: $(git -C "$PROJ" remote 2>/dev/null | tr '\n' ' ')"
  ORIG_URL="$(git -C "$PROJ" remote get-url origin 2>/dev/null || true)"
  if [ -n "$ORIG_URL" ]; then
    echo "  origin (masked): $(printf '%s' "$ORIG_URL" | mask)"
  fi
  # F17 (audit): print what URL the credential file points to (masked) so the
  # agent can sanity-check it BEFORE doing recovery. Previously, the kit just
  # said "credential file exists; holds the origin URL — never print it" — but
  # an agent doing fresh-chat recovery has no way to know whether the URL is
  # the RIGHT one for this session. Showing the masked URL lets the agent
  # immediately spot a stale credential file (audit F16/F17 root cause).
  # Friction #19: only the /home/user_skills copy exists post-v3.1 (mode 0600,
  # PolarFS). The /home/sync copy is not written anymore (ossfs 0777 hazard).
  CFS=""
  [ "$LIVE" = 1 ] && CFS="/home/user_skills/${PREFIX}-remote.url"
  for cf in $CFS; do
    if [ -s "$cf" ]; then
      CF_URL="$(cat "$cf" 2>/dev/null || true)"
      echo "credential file: $cf"
      echo "  → $(printf '%s' "$CF_URL" | mask)"
    fi
  done
  WT="$(git -C "$PROJ" worktree list 2>/dev/null | tail -n +2 | mask)"
  if [ -n "$WT" ]; then echo "worktrees:"; echo "$WT"; else echo "worktrees: none"; fi
else
  echo "no .git in $PROJ — bootstrap template or wiped."
  echo "  recover: clone your remote into $PROJ  OR  see 'Restore procedures' in SKILL.md"
fi

if [ "$LIVE" = 1 ]; then
  line "watchdog hygiene"
  BR="$(git -C "$PROJ" branch --show-current 2>/dev/null || true)"
  if [ -z "$BR" ] && git -C "$PROJ" rev-parse HEAD >/dev/null 2>&1; then
    echo "detached HEAD ($(git -C "$PROJ" rev-parse --short HEAD)) — the prelude will"
    echo "git-switch to main on the next toolcall. Note this SHA now if you need it."
  elif [ "$BR" = "main" ]; then
    echo "on main — watchdog prelude (git switch main) is a no-op. Safe."
  elif ! git -C "$PROJ" show-ref --verify --quiet refs/heads/main 2>/dev/null; then
    CURBR="$(git -C "$PROJ" branch --show-current 2>/dev/null || echo '?')"
    if [ -n "$CURBR" ] && [ "$CURBR" != "?" ]; then
      echo "no 'main' branch exists (current default: '$(printf '%s' "$CURBR" | mask)')!"
      echo "  the prelude runs 'git switch main' every toolcall and fails; rename once:"
      echo "    git -C $PROJ branch -m '$(printf '%s' "$CURBR" | mask)' main && git push origin HEAD:main"
    else
      echo "no 'main' branch and no commits yet — the first commit will create it;"
      echo "  make sure it is named main: git -C $PROJ symbolic-ref HEAD refs/heads/main"
    fi
  else
    echo "NOT on main ('$(printf '%s' "$BR" | mask)'): the prelude 'git switch main' will run before your"
    echo "  next toolcall and revert working-tree files to main's content!"
    echo "  -> git -C $PROJ switch main   (or move this work to a worktree; SKILL.md law 5)"
  fi
  OTHER="$(git -C "$PROJ" branch --format='%(refname:short)' 2>/dev/null | grep -vx main | tr '\n' ' ' | mask)"
  [ -n "${OTHER// /}" ] && echo "other branches (safe on refs; never checkout them here): $OTHER"

  # R10-5: detect placeholder git identity (Vercel blocks deploys from Z User <z@container>)
  GIT_NAME=$(git -C "$PROJ" config user.name 2>/dev/null || true)
  GIT_EMAIL=$(git -C "$PROJ" config user.email 2>/dev/null || true)
  if [ "$GIT_NAME" = "Z User" ] || [ "$GIT_EMAIL" = "z@container" ] || [ -z "$GIT_NAME" ]; then
    echo "⚠️  placeholder git identity detected: name='$GIT_NAME' email='$GIT_EMAIL'"
    echo "    Vercel blocks deploys from Z User <z@container>. Fix before committing:"
    echo "      git config user.name \"<GitHub username>\""
    echo "      git config user.email \"<id>+<username>@users.noreply.github.com\""
    echo "    (get your exact noreply email from GitHub settings)"
  fi
else
  line "watchdog hygiene"
  echo "skipped — watchdog only applies to /home/z/my-project (ZK_PROJ override detected)"
fi

line "kit & config"
# kit v4.0 zero-install model: ONE canonical package per account + a tiny
# per-project config (.agents/config — the .env pattern). No per-project
# kit copies exist; v3 leftovers are reported, not migrated silently.
if [ -f "$USK/z-container-kit/SKILL.md" ]; then
  echo "canonical kit: $USK/z-container-kit (v$(sed -n 's/^  version: "\(.*\)"/\1/p' "$USK/z-container-kit/SKILL.md" 2>/dev/null | head -1))"
else
  echo "MISSING: canonical kit $USK/z-container-kit"
  echo "  bootstrap: git clone https://github.com/super-z-kits/z-container-kit.git /tmp/my-project/kit"
fi
if [ -f "$USK/z-container.zip" ]; then
  echo "portable zip: present"
else
  echo "portable zip: MISSING (the next zsave rebuilds it — the platform consumes it at sub-agent spawn)"
fi
if [ -n "$PREFIX" ]; then
  echo "project config: $PROJ/.agents/config (ZK_PREFIX=$PREFIX)"
else
  echo "project config: MISSING — initialize: bash $SCRIPT_DIR/zk-init <name>"
fi
# shared-artifact prefixes: INFO only — on a multi-repo account these are
# ambiguous evidence, never identity (the zk-onboard-test lesson)
FOUND=""
[ -f "$SCRIPT_DIR/resolve-prefix.sh" ] && FOUND="$(_zk_found_prefixes 2>/dev/null || true)"
[ -n "$(printf '%s' "$FOUND" | tr -d ' ')" ] && echo "account prefixes (shared artifacts — pick yours, never adopt blindly):$FOUND"
# v3 kit leftovers (harmless: v4 helpers never read them)
V3LEFT=""
for p in SKILL.md reference.md README.md scripts kb evidence; do
  [ -e "$PROJ/.agents/$p" ] && V3LEFT="$V3LEFT .agents/$p"
done
[ -e "$PROJ/skills/z-container" ] && V3LEFT="$V3LEFT skills/z-container"
if [ -n "$V3LEFT" ]; then
  echo "v3 kit leftovers (harmless; strip with: bash $SCRIPT_DIR/zk-init --migrate-v3):$V3LEFT"
fi
# multi-kit registry: every other skill dir under /home/user_skills
for d in "$USK"/*/; do
  [ -d "$d" ] || continue
  n="$(basename "$d")"
  [ "$n" = "z-container-kit" ] && continue
  [ -f "$d/SKILL.md" ] || continue
  v="$(sed -n 's/^  version: "\(.*\)"/\1/p' "$d/SKILL.md" 2>/dev/null | head -1)"
  echo "kit: $n${v:+ (v$v)}"
done
for legacy in "$PROJ/z-container-kit" "$SYNC/z-container-kit"; do
  [ -e "$legacy" ] && echo "legacy v2 kit copy still present (remove manually): $legacy"
done

line "services"
if ss -tln 2>/dev/null | grep -qE ':(3000|3001)\b'; then
  ss -tln | grep -E ':(3000|3001)\b'
else
  echo "no dev server on :3000/:3001 (normal unless my-project has package.json)"
fi
if [ "$LIVE" = 1 ] && [ -d "$PROJ/mini-services" ]; then
  echo "mini-services: $(ls "$PROJ/mini-services" 2>/dev/null | tr '\n' ' ')"
fi

line "recommended actions"
n=0
rec() { n=$((n + 1)); echo "$n. $*"; }

# fresh-chat cold start: no remote, no state — print the exact bootstrap
# sequence (do NOT recommend zsave before identity is set)
COLD=0
if [ "$LIVE" = 1 ] && [ ! -f "$STATE" ] && ! git -C "$PROJ" remote get-url origin >/dev/null 2>&1; then
  COLD=1
  KITSRC=""
  for p in /home/user_skills/z-container-kit "$SYNC/z-container-kit" "$PROJ/z-container-kit"; do
    [ -f "$p/scripts/zsave" ] && { KITSRC="$p"; break; }
  done
  echo "COLD START detected (no remote, no zsave state). Exact sequence:"
  if [ -n "$KITSRC" ]; then
    echo "  0. kit available at: $KITSRC (zero-install — run helpers from there)"
  else
    echo "  0. git clone https://github.com/super-z-kits/z-container-kit.git /tmp/my-project/kit"
    echo "     (helpers run straight from the clone — nothing to install)"
  fi
  # multi-repo aware: list EVERY credential file, let the agent pick ITS project's
  NCF=0
  for cf in "$USK"/*-remote.url; do
    [ -s "$cf" ] || continue
    NCF=$((NCF+1))
    CF_URL="$(cat "$cf" 2>/dev/null || true)"
    echo "  1. credential file found: $cf -> $(printf '%s' "$CF_URL" | mask)"
  done
  if [ "$NCF" = 0 ]; then
    echo "  1. git -C $PROJ remote add origin https://<PAT>@github.com/<user>/<repo>.git  # ask the user if no PAT"
  elif [ "$NCF" -gt 1 ]; then
    echo "     ^ multiple credential files = multiple projects on this account —"
    echo "     pick THIS session's project by its prefix (filename before -remote.url)"
  fi
  echo "  2. git -C $PROJ remote add origin \"\$(cat <your-credential-file>)\""
  echo "     git -C $PROJ fetch origin"
  echo "     git -C $PROJ log origin/main --oneline -5 | sed -E 's|(ghp_[A-Za-z0-9]+)|(***PAT***)|g'   # SANITY CHECK before reset (F18)"
  echo "     git -C $PROJ reset --hard origin/main   # empty remote? skip"
  echo "  3. project identity comes back WITH the repo (.agents/config is committed):"
  echo "     source $PROJ/.agents/config && echo \$ZK_PREFIX   # verify — if absent:"
  echo "     bash ${KITSRC:-/tmp/my-project/kit}/scripts/zk-init <name>"
  echo "  4. bash ${KITSRC:-/tmp/my-project/kit}/scripts/zsave 'fresh-chat bootstrap checkpoint'"
  echo
fi

if [ ! -e "$PROJ/.git" ]; then
  rec "no repo — clone your remote into $PROJ or see 'Restore procedures' in SKILL.md"
fi
if [ "$COLD" != 1 ] && ! git -C "$PROJ" remote get-url origin >/dev/null 2>&1; then
  CRED=""
  CFS=""
  [ "$LIVE" = 1 ] && CFS="/home/user_skills/${PREFIX}-remote.url"
  for cf in $CFS; do
    [ -s "$cf" ] && { CRED="$cf"; break; }
  done
  if [ -n "$CRED" ]; then
    rec "recover remote: git -C $PROJ remote add origin \"\$(cat $CRED)\"  (credential file found: $CRED)"
  else
    rec "add remote: git -C $PROJ remote add origin https://<PAT>@github.com/<user>/<repo>.git (github = only cross-chat persistence)"
  fi
fi
if [ -z "$PREFIX" ] && [ "$COLD" != 1 ]; then
  rec "no project identity — initialize: bash $SCRIPT_DIR/zk-init <name>  (or source an existing .agents/config)"
fi
if [ -n "$(git -C "$PROJ" status --porcelain 2>/dev/null)" ]; then
  rec "dirty tree — checkpoint: bash $SCRIPT_DIR/zsave 'session-start checkpoint' (commits ALL current state incl. .env)"
fi
# m12 (audit): dedupe — the previous version recommended "run zsave" twice in some
# states (once for dirty tree, once for "no state yet"). The dirty-tree rec above
# already creates state, so skip the "no state yet" rec when the tree is dirty.
if [ "$LIVE" = 1 ]; then
  BR2="$(git -C "$PROJ" branch --show-current 2>/dev/null || true)"
  if [ -n "$BR2" ] && [ "$BR2" != "main" ]; then
    rec "return to main: git -C $PROJ switch main"
  fi
  # m12: only recommend "initial zsave" if tree is clean AND no state yet (avoids
  # double-issuing the same action)
  if [ ! -f "$STATE" ] && [ -z "$(git -C "$PROJ" status --porcelain 2>/dev/null)" ]; then
    rec "no zsave state yet — run: bash $SCRIPT_DIR/zsave 'initial checkpoint'"
  fi
  # m11 (audit): note if worklog.md is absent so the agent knows to create one.
  # Round-11 F4/F9: the worklog is COMMITTED (survives cross-chat). If it is
  # missing, first try to recover it from git history before starting blank —
  # a "cleanup" commit once removed it from tracking and the content lived on
  # only in history. The protocol itself is preset-provided; the container
  # deltas (committed-by-zsave, recovery) live in kb/sub-agents.md.
  if [ ! -f "$PROJ/worklog.md" ]; then
    WL_HIST="$(git -C "$PROJ" log --all --oneline -- worklog.md 2>/dev/null | head -1)"
    if [ -n "$WL_HIST" ]; then
      rec "worklog.md missing but present in history ($WL_HIST) — recover: git -C $PROJ show <that-commit>:worklog.md > $PROJ/worklog.md"
    else
      rec "create worklog: touch $PROJ/worklog.md  (append-only, preset worklog protocol; zsave commits it — container deltas: kb/sub-agents.md)"
    fi
  fi
fi
if [ "$n" -eq 0 ]; then
  if [ "$COLD" = 1 ]; then
    echo "no other actions — follow the cold-start sequence above."
  else
    echo "none — everything looks healthy. Continue work; zsave at the next micro-milestone (any good moment)."
  fi
fi
echo "(report only — no persistent changes; mount checks use a unique .${PREFIX}-rw-$$ probe file)"

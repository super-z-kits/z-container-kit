#!/usr/bin/env bash
# zcleanup-backups — prune old backup dirs from /home/user_skills/
#
# OF-14: /home/user_skills/ accumulates .pre-update-backup-*, .pre-export-*,
# .pre-round-*, .pre-rollback-* dirs from install-user-skill + manual cp -r.
# This script keeps the newest N (default 2) per skill and deletes the rest.
#
# Usage:
#   zcleanup-backups              # keep last 2 per skill
#   zcleanup-backups 5            # keep last 5
#   zcleanup-backups 0            # delete ALL backups (use with caution)
#   USER_SKILLS_DIR=/tmp/x zcleanup-backups   # override target

set -euo pipefail

# Parse args — R10 critical fix: --help/--dry-run/-h were being treated as KEEP
# value, causing the integer comparison to fail and ALL backups to be deleted.
KEEP="2"
DRY_RUN=0
FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      cat <<EOF
zcleanup-backups — prune old backup dirs from /home/user_skills/

Usage: zcleanup-backups [N] [--dry-run] [--force]
  N         keep last N backups per skill (default: 2; 0 = delete all)
  --dry-run show what would be deleted without deleting
  --force    skip confirmation prompt (use with caution)

Env: USER_SKILLS_DIR (default: /home/user_skills)
EOF
      exit 0 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --force) FORCE=1; shift ;;
    -*|--) echo "unknown flag: $1 (use --help)" >&2; exit 2 ;;
    *)
      if ! [[ "$1" =~ ^[0-9]+$ ]]; then
        echo "error: KEEP must be a non-negative integer, got: $1" >&2
        exit 2
      fi
      KEEP="$1"; shift ;;
  esac
done

USER_SKILLS_DIR="${USER_SKILLS_DIR:-/home/user_skills}"

if [ ! -d "$USER_SKILLS_DIR" ]; then
  echo "no $USER_SKILLS_DIR — nothing to clean"
  exit 0
fi

# Count backups first (for confirmation)
BACKUP_COUNT=$(ls -d "$USER_SKILLS_DIR"/*.pre-update-backup-* \
                  "$USER_SKILLS_DIR"/*.pre-export-* \
                  "$USER_SKILLS_DIR"/*.pre-round-* \
                  "$USER_SKILLS_DIR"/*.pre-rollback-* 2>/dev/null | wc -l)

if [ "$BACKUP_COUNT" -eq 0 ]; then
  echo "no backup dirs found in $USER_SKILLS_DIR"
  exit 0
fi

echo "=== backup cleanup: keep last $KEEP per skill in $USER_SKILLS_DIR ==="
[ "$DRY_RUN" = 1 ] && echo "  (DRY RUN — no deletions will happen)"

# Confirmation prompt (unless --force or --dry-run)
if [ "$FORCE" = 0 ] && [ "$DRY_RUN" = 0 ]; then
  echo "  found $BACKUP_COUNT backup dir(s)"
  read -r -p "  proceed with deletion? [y/N] " ans </dev/tty || ans=""
  case "$ans" in
    y|Y) echo "  proceeding..." ;;
    *)   echo "  aborted."; exit 0 ;;
  esac
fi

# Group backups by skill name (strip the .pre-* suffix)
declare -A counts
DELETED=0
KEPT=0

for backup in "$USER_SKILLS_DIR"/*.pre-update-backup-* \
               "$USER_SKILLS_DIR"/*.pre-export-* \
               "$USER_SKILLS_DIR"/*.pre-round-* \
               "$USER_SKILLS_DIR"/*.pre-rollback-* \
               "$USER_SKILLS_DIR"/*.pre-update-backup-*; do
  [ -d "$backup" ] || continue
  # Extract skill name (everything before .pre-)
  skill=$(basename "$backup" | sed 's/\.pre-.*//')
  counts["$skill"]=$(( ${counts["$skill"]:-0} + 1 ))
done

# For each skill, sort backups by mtime (newest first), keep top N, delete rest
for skill in "${!counts[@]}"; do
  total=${counts[$skill]}
  echo "  $skill: $total backup(s) found"
  
  # List backups for this skill, newest first
  backups=$(ls -dt "$USER_SKILLS_DIR/${skill}.pre-"* 2>/dev/null)
  
  n=0
  while IFS= read -r backup; do
    [ -z "$backup" ] && continue
    n=$((n + 1))
    if [ "$n" -le "$KEEP" ]; then
      echo "    keep: $(basename "$backup")"
      KEPT=$((KEPT + 1))
    else
      if [ "$DRY_RUN" = 1 ]; then
        echo "    would delete: $(basename "$backup")"
      else
        rm -rf "$backup"
        echo "    deleted: $(basename "$backup")"
      fi
      DELETED=$((DELETED + 1))
    fi
  done <<< "$backups"
done

echo
echo "=== done: kept $KEPT, deleted $DELETED ==="
